page {
  height: 100%;
  background-color: #f0f2f5;
}

.dw-shell {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.navbar-left {
  width: 80rpx;
  padding-left: 24rpx;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.navbar-right {
  width: 80rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.dw-content {
  flex: 1;
  overflow-y: auto;
}

.form-container {
  padding: 24rpx;
}

.form-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-required {
  color: #ee0a24;
}

.form-hint {
  font-size: 24rpx;
  color: #0f766e;
  margin-top: 8rpx;
}

.picker {
  font-size: 32rpx;
  color: #1a1a1a;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.picker-with-arrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.picker-value {
  font-size: 32rpx;
  color: #1a1a1a;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #c0c4cc;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.dw-radio {
  margin-right: 40rpx;
  margin-top: 12rpx;
}

.dw-input {
  font-size: 32rpx;
  color: #1a1a1a;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  width: 100%;
}

/* 工资预览 */
.wage-preview {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.preview-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #333;
}

.preview-val {
  color: #0f766e;
  font-weight: 500;
}

.total-row {
  border-top: 2rpx solid #f0f0f0;
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.total-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #e74c3c;
}

.form-actions {
  padding: 24rpx 0 48rpx;
}

/* 人员选择弹窗 */
.user-picker-container {
  display: flex;
  flex-direction: column;
  height: 70vh;
}

.user-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.user-count {
  font-size: 26rpx;
  color: #0f766e;
}

.user-search-bar {
  padding: 0;
}

.user-search-bar .van-search {
  padding: 12rpx 16rpx;
}

.user-scroll-view {
  flex: 1;
  min-height: 0;
}

.user-cell-title {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 30rpx;
  color: #1a1a1a;
}

.user-dept {
  font-size: 24rpx;
  color: #999;
}

.user-picker-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.user-picker-footer .van-button {
  flex: 1;
}
