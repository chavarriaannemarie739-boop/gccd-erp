/* 我的：分区 + van-cell 二级菜单（与改前 is-link 行为一致） */
.page-content.mine-page {
  margin: 0;
  padding: 24rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background-color: #f0f2f5;
  min-height: 100vh;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid #e5e7eb;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 4rpx solid #f3f4f6;
  overflow: hidden;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.welcome {
  font-size: 26rpx;
  color: #6b7280;
}

.mine-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #9ca3af;
  margin: 0 8rpx 16rpx;
  letter-spacing: 0.02em;
}

.menu-list {
  margin-bottom: 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.04);
}

.logout-btn {
  margin: 24rpx 8rpx 0;
}
