<repair-form show="{{showRepairForm}}" device_code="{{repairData.device_code}}" bind:close="closeRepairForm" bind:success="onRepairSuccess" />
<van-toast id="van-toast" />
<van-toast id="van-toast" />

<!-- 页面内容：走页面滚动；底栏单独 fixed（仅本页包裹，不与 van-tabs 抢高度） -->
<view class="material-content page-content page-content--sub-tab" style="padding-top: {{statusBarHeight + 44}}px">
    
    <!-- 快捷操作区 (金刚区) -->
    <view class="quick-actions-container">
        <view class="action-card card-blue" bindtap="showRoundSteelRequest">
            <view class="card-icon-wrap">
                <van-icon name="setting-o" size="24px" color="#ffffff"/>
            </view>
            <view class="card-info">
                <text class="card-title">圆钢领料申请</text>
                <text class="card-desc">查看圆钢库并申请</text>
            </view>
        </view>
        <view class="action-card card-orange" bindtap="showAccessoriesRequest">
            <view class="card-icon-wrap">
                <van-icon name="apps-o" size="24px" color="#ffffff"/>
            </view>
            <view class="card-info">
                <text class="card-title">配件领料申请</text>
                <text class="card-desc">查看配件库并申请</text>
            </view>
        </view>
    </view>

    <van-tabs active="{{activeTab}}" bind:change="switchTab" color="#0d9488">
        <van-tab title="物料列表">
            <!-- 物料记录列表 -->
            <view class="material-list">
                <!-- 搜索框 -->
                <van-search value="{{searchParams.material_name}}" placeholder="请输入需要查询的物料名称" use-action-slot bind:change="onSearchChange" bind:search="onSearch">
                    <view slot="action" bind:tap="onClick" style="padding: 0 20rpx;">筛选</view>
                </van-search>

                <!-- 列表内容 -->
                <block wx:if="{{list && list.length > 0}}">
                    <view class="table-container">
                        <!-- 表头 -->
                        <view class="table-header">
                            <view class="th name-col">名称</view>
                            <view class="th spec-col">厂商</view>
                            <view class="th spec-col">材质/规格</view>
                            <view class="th model-col">型号</view>
                            <view class="th stock-col">总库存</view>
                        </view>
                        <!-- 表格内容 -->
                        <view class="table-body">
                            <block wx:for="{{list}}" wx:key="id">
                                <view class="table-row" bindtap="navigateToDetail" data-id="{{item.id}}">
                                    <view class="td name-col">{{item.material_name || '-'}}</view>
                                    <view class="td spec-col">{{item.manufacturer || '-'}}</view>
                                    <view class="td spec-col">{{item.material_spec || '-'}}</view>
                                    <view class="td model-col">{{item.material_model || '-'}}</view>
                                    <view class="td stock-col">{{item.material_num || 0}}</view>
                                </view>
                            </block>
                        </view>
                    </view>
                </block>
                <block wx:else>
                    <van-empty description="暂无物料数据" />
                </block>

                <!-- 筛选弹出层 -->
                <van-popup show="{{showPopu}}" position="right" bind:close="onClosePopu" custom-style="height: 100%; width: 80%;margin-top: {{statusBarHeight + 44}}px" overlay-style="margin-top: {{statusBarHeight + 44}}px">
                    <scroll-view scroll-y style="height: 100%; padding: 20rpx;">
                        <view class="filter-title">筛选条件</view>

                        <!-- 物料名称 -->
                        <view class="filter-item">
                            <text class="filter-label">物料名称</text>
                            <van-field value="{{searchParams.material_name}}" placeholder="请输入物料名称" border="{{true}}" bind:input="onFilterChange" data-field="material_name" />
                        </view>

                        <view class="filter-item">
                            <text class="filter-label">厂商</text>
                            <van-field value="{{searchParams.manufacturer}}" placeholder="请输入厂商" border="{{true}}" bind:input="onFilterChange" data-field="manufacturer" />
                        </view>

                        <view class="filter-item">
                            <text class="filter-label">材质/规格</text>
                            <van-field value="{{searchParams.material_spec}}" placeholder="请输入材质或规格" border="{{true}}" bind:input="onFilterChange" data-field="material_spec" />
                        </view>

                        <view class="filter-item">
                            <text class="filter-label">物料型号</text>
                            <van-field value="{{searchParams.material_model}}" placeholder="请输入物料型号" border="{{true}}" bind:input="onFilterChange" data-field="material_model" />
                        </view>

                        <!-- 按钮区域 -->
                        <view class="filter-buttons">
                            <van-button type="default" bind:tap="onResetFilter">重置</van-button>
                            <van-button type="primary" bind:tap="onSubmitFilter">提交</van-button>
                        </view>
                    </scroll-view>
                </van-popup>
            </view>

            <!-- 物料列表加载状态 -->
            <view class="load-more" wx:if="{{list.length > 0}}">
                <block wx:if="{{!loadingMore}}">
                    <view wx:if="{{currentPage < pages}}" class="load-more-btn" bindtap="loadMore">加载更多</view>
                    <view wx:else class="no-more">没有更多了</view>
                </block>
                <block wx:else>
                    <van-loading size="24px">加载中...</van-loading>
                </block>
            </view>
        </van-tab>

        <van-tab title="领料记录">
            <!-- 领料记录列表 -->
            <view class="receiving-list">
                <!-- 领料记录列表 -->
                <block wx:if="{{receivingList && receivingList.length > 0}}">
                    <view wx:for="{{receivingList}}" wx:key="id" class="receiving-item-container">
                        <view class="receiving-item" bindtap="viewReceivingDetail" data-id="{{item.id}}">
                            <view class="receiving-header">
                                <text class="receiving-title"> {{item.material_name || '暂无'}}</text>
                                <text class="receiving-status {{item.status_class}}">数量：{{item.material_num}}</text>
                            </view>
                            <view class="receiving-body">
                                <view class="receiving-info">
                                    <text class="info-label">领料单号:</text>
                                    <text class="info-value">{{item.receiving_code || '未知'}}</text>
                                </view>
                                <view class="receiving-info">
                                    <text class="info-label">领料时间:</text>
                                    <text class="info-value">{{item.create_time || '未知'}}</text>
                                </view>
                            </view>
                        </view>
                    </view>
                </block>
                <block wx:else>
                    <van-empty description="暂无领料记录" />
                </block>
            </view>

            <!-- 领料记录加载状态 -->
            <view class="load-more" wx:if="{{receivingList.length > 0}}">
                <block wx:if="{{!receivingLoadingMore}}">
                    <view wx:if="{{receivingCurrentPage < receivingPages}}" class="load-more-btn" bindtap="loadMoreReceiving">加载更多</view>
                    <view wx:else class="no-more">没有更多了</view>
                </block>
                <block wx:else>
                    <van-loading size="24px">加载中...</van-loading>
                </block>
            </view>
        </van-tab>
    </van-tabs>
</view>
<!-- 确认删除弹窗 -->
<van-dialog id="van-dialog" />



<view class="material-tabbar-fixed-wrap">
    <main-tab-bar />
</view>

</view>