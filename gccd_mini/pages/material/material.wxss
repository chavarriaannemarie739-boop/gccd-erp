/* 表单样式 */
.form-container {
  width: 100%;
}

.form-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20px;
  color: #333;
}

.form-item {
  margin-bottom: 15px;
}

.form-label {
  display: block;
  margin-bottom: 5px;
  font-size: 14px;
  color: #666;
}

.form-input {
  /* width: 100%; */
  border: 1px solid #eee;
  border-radius: 4px;
  padding: 8px;
  font-size: 14px;
}

.form-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
}

/* 浮动按钮样式 */
.float-buttons-container {
  position: fixed;
  z-index: 999;
}

.float-button {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: #0d9488;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(13, 148, 136, 0.35);
  transition: all 0.3s ease;
}

.float-button:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.button-image {
  width: 28px;
  height: 28px;
}
/* 物料页：页面滚动 + 底栏由页面级 fixed 容器承载（避免 van-tabs 与外层 scroll-view 冲突） */
page {
  background-color: #f0f2f5;
}

.material-tabbar-fixed-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  pointer-events: auto;
}

/* 为底部固定栏留出空间，避免最后一项被挡住 */
.material-content.page-content--sub-tab {
  padding-bottom: calc(56px + constant(safe-area-inset-bottom) + 24rpx);
  padding-bottom: calc(56px + env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
}

/* 页面内容样式 */
.page-content {
  background-color: #f0f2f5;
  min-height: 100vh;
}

/* 优化后的表格布局 */
.table-container {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.table-header {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background-color: #f8f9fa;
  border-bottom: 2rpx solid #edf2f7;
}

.th {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 600;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 2rpx solid #f3f4f6;
  transition: background-color 0.2s;
}

.table-row:active {
  background-color: #f9fafb;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  font-size: 22rpx;
  color: #374151;
}

/* 统一列宽分配 */
.name-col {
  flex: 2;
  word-break: break-all;
  padding-right: 8rpx;
}
.spec-col {
  flex: 1.5;
  word-break: break-all;
  padding-right: 8rpx;
}
.model-col {
  flex: 1.5;
  word-break: break-all;
  padding-right: 8rpx;
}
.stock-col {
  flex: 1.2;
  text-align: center;
  font-weight: 500;
  color: #0d9488;
}

/* 领料记录列表项样式 */
.receiving-item-container {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid #e5e7eb;
  transition: all 0.3s ease;
}

.material-item-container:active,
.receiving-item-container:active {
  transform: translateY(2px);
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.1);
}

.material-item,
.receiving-item {
  padding: 0;
}

.item-header,
.receiving-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 15px;
  border-bottom: 1px solid #f5f5f5;
}

.item-name,
.receiving-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-quantity,
.receiving-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 500;
}

.item-quantity {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.item-body,
.receiving-body {
  padding: 10px 15px;
  font-size: 14px;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
  /* margin-bottom: 8px; */
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  min-width: 100%;
  margin-bottom: 6px;
  font-size: 13px;
  display: flex;
  align-items: center;
}

.info-item.full-width {
  min-width: 100%;
}

.info-label {
  color: #999;
  margin-right: 10px;
  flex-shrink: 0;
  width: 70px;
}

.info-value {
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载更多样式 */
.load-more {
  text-align: center;
  padding: 16px;
  color: #999;
  font-size: 14px;
}

.load-more-btn {
  color: #0f766e;
  cursor: pointer;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  background-color: #ccfbf1;
  display: inline-block;
  transition: all 0.3s;
}

.no-more {
  color: #969799;
}

.empty {
  padding-top: 100px;
}

/* 筛选弹窗样式 */
.filter-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin: 20rpx 0 30rpx;
  color: #333;
}

.filter-item {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 14px;
  color: #666;
  font-weight: 500;
}

.filter-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 0 20rpx;
}

/* 领料记录状态样式 */
.receiving-status.status-pending {
  color: #ff976a;
  background-color: rgba(255, 151, 106, 0.1);
}

.receiving-status.status-approved {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.receiving-status.status-rejected {
  color: #ee0a24;
  background-color: rgba(238, 10, 36, 0.1);
}
/* 快捷操作区 (金刚区) */
.quick-actions-container {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: #f0f2f5;
  gap: 20rpx;
}

.action-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.action-card:active {
  transform: scale(0.96);
}

.card-blue {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}

.card-orange {
  background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);
}

.card-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.card-info {
  display: flex;
  flex-direction: column;
}

.card-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.card-desc {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}
