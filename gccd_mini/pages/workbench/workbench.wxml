<view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
  <view class="navbar-left">
    <scan-code bind:scanSuccess="onScanSuccess" />
  </view>
  <view class="navbar-title">工作台</view>
  <view class="navbar-right"></view>
</view>

<view class="page-content" style="padding-top: {{statusBarHeight + 44}}px">
  <view class="wb-section-title">车间常用</view>
  <view class="wb-grid">
    <view class="wb-tile" bindtap="goReport" hover-class="wb-tile--hover">
      <text class="wb-tile-title">{{reportTitle}}</text>
      <text class="wb-tile-desc">{{reportDesc}}</text>
    </view>
    <navigator url="/pages/material/material" open-type="navigate" hover-class="wb-tile--hover" class="wb-tile">
      <text class="wb-tile-title">物料</text>
      <text class="wb-tile-desc">领料与查询</text>
    </navigator>
    <navigator url="/pages/energy/energy" open-type="navigate" hover-class="wb-tile--hover" class="wb-tile">
      <text class="wb-tile-title">能耗</text>
      <text class="wb-tile-desc">记录与查询</text>
    </navigator>
    <navigator url="/pageWorkOrder/pages/maintenanceReport/maintenanceReport?type=jixiu" open-type="navigate" hover-class="wb-tile--hover" class="wb-tile">
      <text class="wb-tile-title">机修报工</text>
      <text class="wb-tile-desc">维修班组报工</text>
    </navigator>
    <navigator url="/pageWorkOrder/pages/maintenanceReport/maintenanceReport?type=diangong" open-type="navigate" hover-class="wb-tile--hover" class="wb-tile">
      <text class="wb-tile-title">电工报工</text>
      <text class="wb-tile-desc">维修班组报工</text>
    </navigator>
    <navigator url="/pages/dailyWork/dailyWork" open-type="navigate" hover-class="wb-tile--hover" class="wb-tile">
      <text class="wb-tile-title">日工报工</text>
      <text class="wb-tile-desc">设备检修报工</text>
    </navigator>
  </view>

  <view class="wb-section-title wb-section-title--sub">常用</view>
  <navigator url="/pageMine/pages/workRecord/workRecord" open-type="navigate" hover-class="wb-record-nav--hover" class="wb-record-nav">
    <view class="wb-record-card">
      <view class="wb-record-icon-wrap">
        <image class="wb-record-icon" src="/images/search.png" mode="aspectFit" />
      </view>
      <view class="wb-record-text">
        <text class="wb-record-title">报工记录</text>
        <text class="wb-record-desc">按单查看历史报工与明细</text>
      </view>
      <view class="wb-record-action">查看</view>
    </view>
  </navigator>
</view>

<repair-form show="{{showRepairForm}}" device_code="{{repairDeviceCode}}" bind:close="onRepairClose" bind:success="onRepairSuccess" />
<van-toast id="van-toast" />

<van-dialog
  show="{{showPlanInfo}}"
  title="计划信息"
  confirm-button-text="知道了"
  bind:confirm="onPlanInfoClose"
>
  <view class="plan-info-body" wx:if="{{planInfo}}">
    <view class="plan-info-row"><text class="plan-info-label">计划名称</text><text>{{planInfo.production_plan_name}}</text></view>
    <view class="plan-info-row"><text class="plan-info-label">圆钢</text><text>{{planInfo.y_material_spec}}{{planInfo.y_material_model}}</text></view>
    <view class="plan-info-row"><text class="plan-info-label">成品规格</text><text>{{planInfo.c_material_spec}}</text></view>
    <view class="plan-info-row"><text class="plan-info-label">成品型号</text><text>{{planInfo.c_material_model}}</text></view>
    <view class="plan-info-row"><text class="plan-info-label">计划数量</text><text>{{planInfo.plan_num}}</text></view>
  </view>
</van-dialog>
