.page-content {
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #f0f2f5;
  min-height: 100vh;
}

/* glass-easel：整页文档流布局，避免 fixed 顶栏导致首屏不渲染 */
.wb-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f0f2f5;
}

.wb-shell .custom-navbar {
  position: relative;
  flex-shrink: 0;
  top: auto;
  left: auto;
  right: auto;
}

.wb-body {
  flex: 1;
  min-height: 0;
}

.wb-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6b7280;
  margin: 8rpx 8rpx 20rpx;
}

.wb-section-title--sub {
  margin-top: 40rpx;
}

.wb-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx;
}

.wb-tile {
  width: calc(33.33% - 14rpx);
  flex: none;
  min-width: 0;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.wb-tile--hover {
  opacity: 0.92;
}

.wb-tile-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.wb-tile-desc {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.3;
}

/* 报工记录：横向主按钮，与上方宫格区分 */
.wb-record-nav {
  display: block;
}

.wb-record-nav--hover .wb-record-card {
  transform: translateY(1rpx);
  box-shadow: 0 6rpx 24rpx rgba(13, 148, 136, 0.14);
}

.wb-record-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(120deg, #ffffff 0%, #f0fdfa 100%);
  border-radius: 24rpx;
  border: 1rpx solid #99f6e4;
  box-shadow: 0 10rpx 36rpx rgba(13, 148, 136, 0.1);
}

.wb-record-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #0d9488, #14b8a6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.35);
}

.wb-record-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.wb-record-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wb-record-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #134e4a;
}

.wb-record-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

.wb-record-action {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f766e;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background-color: rgba(13, 148, 136, 0.12);
}

.plan-info-body {
  padding: 16rpx 32rpx 8rpx;
  text-align: left;
}

.plan-info-row {
  display: flex;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
  color: #374151;
}

.plan-info-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #6b7280;
}
