/* 页面内容 */
.page-content {
  padding: 0;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f0f2f5;
}

/* 统一列表项样式 */
.list-item-container {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid #e5e7eb;
  transition: all 0.3s ease;
}

.list-item-container:active {
  transform: translateY(2px);
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.1);
}

.list-item {
  padding: 0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 15px;
  border-bottom: 1px solid #f5f5f5;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 500;
}

.item-status.normal {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.item-status.waiting {
  color: #ffd04d;
  background-color: rgba(255, 151, 106, 0.1);
}

.item-status.repairing {
  color: #f50202;
  background-color: rgba(255, 151, 106, 0.1);
}

.item-body {
  padding: 10px 15px;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  min-width: 100%;
  margin-bottom: 6px;
  font-size: 13px;
  display: flex;
  align-items: center;
}

.info-label {
  color: #999;
  margin-right: 10px;
  flex-shrink: 0;
  width: 70px;
}

.info-value {
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  padding: 0 15px 15px;
  gap: 10px;
}

/* 加载更多样式 */
.load-more {
  text-align: center;
  padding: 16px;
  color: #999;
  font-size: 14px;
}

.load-more-btn {
  color: #0f766e;
  cursor: pointer;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  background-color: #ccfbf1;
  display: inline-block;
  transition: all 0.3s;
}

.no-more {
  color: #969799;
}

.empty {
  padding-top: 100px;
}

/* 表单样式 */
.form-container {
  width: 100%;
}

.form-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20px;
  color: #333;
}

.form-item {
  margin-bottom: 15px;
}

.form-label {
  display: block;
  margin-bottom: 5px;
  font-size: 14px;
  color: #666;
}

.form-input {
  border: 1px solid #eee;
  border-radius: 4px;
  padding: 8px;
  font-size: 14px;
}

.form-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
}

/* 图片网格样式 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 8px;
}

.grid-image {
  width: 100%;
  height: 80px;
  border-radius: 4px;
  object-fit: cover;
}

/* 维修记录详情弹窗样式 */
.repair-detail-container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.detail-title {
  font-size: 18px;
  font-weight: bold;
}

.detail-content {
  flex: 1;
  overflow: hidden;
}

.detail-item {
  padding: 10px 0;
}

.detail-info {
  margin-bottom: 10px;
  font-size: 14px;
}

.detail-info .info-label {
  color: #666;
  margin-right: 8px;
}

.detail-info .info-value {
  color: #333;
}
