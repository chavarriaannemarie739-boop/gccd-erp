.page { min-height: 100vh; background: #f0f2f5; }
.custom-navbar { display: flex; align-items: center; height: 44px; background: #fff; position: fixed; top: 0; left: 0; right: 0; z-index: 10; }
.navbar-left { width: 44px; text-align: center; font-size: 28px; color: #0d9488; }
.navbar-title { flex: 1; text-align: center; font-weight: 600; }
.body { padding: 16px; }
.info-card { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 16px; }
.title { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
.spec-row { display: flex; font-size: 13px; line-height: 1.7; color: #334155; }
.spec-label { width: 72px; color: #64748b; flex-shrink: 0; }
.remain { margin-top: 10px; color: #0d9488; font-weight: 600; }
.field { background: #fff; border-radius: 12px; padding: 12px 16px; margin-bottom: 12px; }
.label { display: block; color: #64748b; font-size: 13px; margin-bottom: 8px; }
.input { font-size: 16px; }
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
}
.picker-text { font-size: 17px; color: #1e293b; }
.picker-row.is-placeholder .picker-text { color: #94a3b8; }
.picker-arrow { font-size: 20px; color: #94a3b8; line-height: 1; }
.class-row { display: flex; gap: 12px; }
.class-btn { flex: 1; text-align: center; padding: 10px; border-radius: 8px; background: #f1f5f9; }
.class-btn.active { background: #0d9488; color: #fff; }

.device-popup {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fff;
  border-radius: 16px 16px 0 0;
  overflow: hidden;
}
.device-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 16px 8px;
  flex-shrink: 0;
}
.device-popup-title { font-size: 17px; font-weight: 700; color: #1f2937; }
.device-popup-count { font-size: 13px; color: #9ca3af; }
.device-popup-list { flex: 1; overflow-y: auto; }
.device-popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px;
  border-bottom: 1px solid #f3f4f6;
}
.device-popup-item--hover { background: #f0fdfa; }
.device-popup-item.is-selected { background: #ecfdf5; }
.device-popup-name { font-size: 18px; font-weight: 600; color: #1f2937; }
.device-popup-check { font-size: 18px; font-weight: 700; color: #0d9488; }
.device-popup-footer {
  flex-shrink: 0;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.04);
}
