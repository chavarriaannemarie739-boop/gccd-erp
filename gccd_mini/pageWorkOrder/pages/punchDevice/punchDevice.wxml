<view class="page">
  <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
    <view class="navbar-left" bindtap="goBack">‹</view>
    <view class="navbar-title">选择穿孔设备</view>
    <view class="navbar-right"></view>
  </view>
  <view class="body" style="padding-top: {{statusBarHeight + 44}}px">
    <view wx:for="{{devices}}" wx:key="device_code" class="dev-card" bindtap="selectDevice" data-code="{{item.device_code}}" data-name="{{item.device_name}}">
      <text>{{item.device_name || item.device_code}}</text>
    </view>
  </view>
  <van-toast id="van-toast" />
</view>
