/* ====== 页面骨架 ====== */
.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--gcc-bg);
  box-sizing: border-box;
}

.tab-scroll {
  height: calc(100vh - 140px);
}

.tab-inner {
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 48rpx;
}

/* ====== Tab1：今日填报（原有样式） ====== */

.date-banner {
  background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);
  border: 1rpx solid #99f6e4;
  border-radius: var(--gcc-radius);
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--gcc-shadow-sm);
}

.date-banner-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.date-label {
  font-size: 26rpx;
  color: var(--gcc-text-secondary);
}

.date-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gcc-primary-dark);
}

.date-hint {
  font-size: 24rpx;
  color: var(--gcc-text-muted);
  padding-left: 44rpx;
}

/* ====== 智能推算按钮 ====== */
.auto-calc-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.auto-calc-hint {
  font-size: 22rpx;
  color: var(--gcc-text-muted);
}

.process-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.process-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  background-color: var(--gcc-surface);
  border-radius: var(--gcc-radius);
  border: 1rpx solid var(--gcc-border);
  box-shadow: var(--gcc-shadow-card);
  transition: transform 0.15s, box-shadow 0.15s;
}

.process-card--hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.1);
}

.process-card-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.process-index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: #f3f4f6;
  color: var(--gcc-text-muted);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background-color 0.2s, color 0.2s;
}

.process-index--done {
  background: linear-gradient(145deg, #0d9488, #14b8a6);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(13, 148, 136, 0.3);
}

.process-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.process-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gcc-text);
}

.shift-status {
  display: flex;
  gap: 16rpx;
}

.shift-tag {
  font-size: 22rpx;
  color: var(--gcc-text-muted);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background-color: #f3f4f6;
}

.shift-tag--done {
  color: #0f766e;
  background-color: #ccfbf1;
}

.process-card-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.go-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gcc-primary);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background-color: rgba(13, 148, 136, 0.1);
}

/* ====== Tab2：盘点记录 ====== */

/* 空状态 */
.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
  gap: 16rpx;
}

.history-empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gcc-text-secondary);
  margin-top: 16rpx;
}

.history-empty-hint {
  font-size: 24rpx;
  color: var(--gcc-text-muted);
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 天卡片 */
.day-card {
  background-color: var(--gcc-surface);
  border-radius: var(--gcc-radius);
  border: 1rpx solid var(--gcc-border);
  box-shadow: var(--gcc-shadow-card);
  overflow: hidden;
}

.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  gap: 16rpx;
}

.day-header-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.day-date-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.day-date {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gcc-text);
}

.day-weekday {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--gcc-primary);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background-color: #f0fdfa;
}

.day-summary {
  display: flex;
  align-items: center;
}

.day-summary-text {
  font-size: 24rpx;
  color: var(--gcc-text-muted);
}

.day-header-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.day-totals {
  display: flex;
  align-items: center;
}

.day-total-item {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.day-total--single {
  color: #0f766e;
  background-color: #ccfbf1;
}

/* 天内容区 */
.day-body {
  border-top: 1rpx solid var(--gcc-border);
}

/* 工序分组 */
.proc-group {
  border-bottom: 1rpx solid #f3f4f6;
}

.proc-group:last-child {
  border-bottom: none;
}

.proc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  background-color: #fafbfc;
}

.proc-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.proc-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background-color: var(--gcc-primary);
}

.proc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gcc-text);
}

.proc-count {
  font-size: 22rpx;
  color: var(--gcc-text-muted);
}

.proc-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.proc-subtotal {
  font-size: 22rpx;
  color: var(--gcc-text-secondary);
}

/* 工序明细 */
.proc-detail {
  padding: 0 28rpx 16rpx;
}

.detail-head-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--gcc-border);
}

.dh {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--gcc-text-muted);
  text-align: center;
}

.dh-mat {
  flex: 2.5;
  text-align: left;
}

.dh-qty {
  flex: 1.5;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.detail-row:last-child {
  border-bottom: none;
}

.dr {
  font-size: 26rpx;
  color: var(--gcc-text);
  text-align: center;
}

.dr-mat {
  flex: 2.5;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-align: left;
}

.dr-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gcc-text);
}

.dr-spec {
  font-size: 22rpx;
  color: var(--gcc-text-muted);
}

.dr-qty {
  flex: 1.5;
  font-weight: 600;
  font-size: 26rpx;
}
