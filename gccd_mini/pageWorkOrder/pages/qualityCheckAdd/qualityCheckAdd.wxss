.page-content { padding: 24rpx 24rpx 48rpx; min-height: 100vh; background-color: var(--gcc-bg); box-sizing: border-box; }

/* 日期条（紫色） */
.date-bar--qc { display: flex; align-items: center; gap: 10rpx; padding: 20rpx 24rpx; background-color: #eef2ff; border-radius: var(--gcc-radius-sm); margin-bottom: 28rpx; border: 1rpx solid #c7d2fe; }
.date-bar--qc .date-bar-text { font-size: 26rpx; font-weight: 500; color: #4338ca; }

/* 分区 */
.section { margin-bottom: 28rpx; }
.section-title { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; padding-left: 4rpx; }
.section-dot { width: 8rpx; height: 32rpx; border-radius: 4rpx; background-color: var(--gcc-primary); }
.section-dot--qc { background-color: #6366f1; }
.section-title text { font-size: 28rpx; font-weight: 600; color: var(--gcc-text); }
.section-count { font-size: 24rpx !important; font-weight: 400 !important; color: var(--gcc-text-muted) !important; margin-left: 8rpx; }
.section-hint { font-size: 22rpx !important; font-weight: 400 !important; color: var(--gcc-text-muted) !important; margin-left: auto; }

/* 表单卡片 */
.form-card { background-color: var(--gcc-surface); border-radius: var(--gcc-radius); border: 1rpx solid var(--gcc-border); box-shadow: var(--gcc-shadow-sm); overflow: hidden; }
.form-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; transition: background-color 0.15s; }
.form-row--hover { background-color: #f9fafb; }
.form-label { font-size: 28rpx; color: var(--gcc-text); font-weight: 500; flex-shrink: 0; }
.form-value-wrap { display: flex; align-items: center; gap: 8rpx; }
.form-value { font-size: 28rpx; color: var(--gcc-text); }
.form-value--placeholder { color: var(--gcc-text-muted); }
.form-divider { height: 1rpx; background-color: var(--gcc-border); margin: 0 28rpx; }

/* 不良品明细卡片 */
.defect-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 16rpx; }

.defect-card {
  background-color: var(--gcc-surface); border-radius: var(--gcc-radius);
  border: 1rpx solid var(--gcc-border); box-shadow: var(--gcc-shadow-sm); overflow: hidden;
}

.defect-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background-color: #fafbfc; border-bottom: 1rpx solid #f3f4f6;
}
.defect-name { font-size: 28rpx; font-weight: 600; color: var(--gcc-text); }
.defect-remove { padding: 8rpx; }

.defect-inputs { display: flex; gap: 16rpx; padding: 20rpx 24rpx; }

.defect-input-group {
  flex: 1; display: flex; align-items: center; gap: 8rpx;
  background-color: #f9fafb; border: 1rpx solid var(--gcc-border);
  border-radius: 12rpx; padding: 12rpx 16rpx;
}
.defect-shift-label { font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.defect-shift--day { color: #92400e; }
.defect-shift--night { color: #3730a3; }
.defect-input { flex: 1; height: 48rpx; font-size: 32rpx; font-weight: 600; text-align: center; background: transparent; color: var(--gcc-text); }
.defect-unit { font-size: 24rpx; color: var(--gcc-text-muted); flex-shrink: 0; }

/* 添加按钮（紫色） */
.add-btn-wrap { margin-bottom: 28rpx; }
.add-btn--qc { display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 24rpx 0; background-color: var(--gcc-surface); border: 2rpx dashed #c7d2fe; border-radius: var(--gcc-radius); transition: background-color 0.15s; }
.add-btn--hover-qc { background-color: #eef2ff; }
.add-btn-text--qc { font-size: 28rpx; font-weight: 600; color: #6366f1; }

/* 已添加记录卡片 */
.record-card {
  background-color: var(--gcc-surface); border-radius: var(--gcc-radius);
  border: 1rpx solid var(--gcc-border); box-shadow: var(--gcc-shadow-sm);
  margin-bottom: 16rpx; overflow: hidden;
}
.record-header { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx; background-color: #fafbfc; border-bottom: 1rpx solid #f3f4f6; }
.record-material { display: flex; flex-direction: column; gap: 4rpx; flex: 1; min-width: 0; }
.record-mat-label { font-size: 28rpx; font-weight: 600; color: var(--gcc-text); }
.record-mat-sub { font-size: 24rpx; color: var(--gcc-text-muted); }
.record-remove { padding: 8rpx; flex-shrink: 0; }

.record-defects { padding: 16rpx 24rpx; }
.record-defect-row { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0; }
.record-defect-name { font-size: 26rpx; color: var(--gcc-text-secondary); flex: 1; }
.record-defect-qty { display: flex; gap: 12rpx; flex-shrink: 0; }
.qc-shift-tag { font-size: 22rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 8rpx; }
.qc-shift--day { color: #92400e; background-color: #fef3c7; }
.qc-shift--night { color: #3730a3; background-color: #e0e7ff; }

.remark-card { padding: 20rpx 28rpx; }
.remark-input { width: 100%; height: 160rpx; font-size: 28rpx; color: var(--gcc-text); line-height: 1.5; }

.submit-wrap { margin-top: 16rpx; padding-bottom: env(safe-area-inset-bottom); }

/* ====== 搜索弹窗（复用盘点页样式） ====== */
.search-popup { display: flex; flex-direction: column; height: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; overflow: hidden; }
.search-popup-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 12rpx; flex-shrink: 0; }
.search-popup-title { font-size: 32rpx; font-weight: 700; color: var(--gcc-text); }
.search-popup-count { font-size: 24rpx; color: var(--gcc-text-muted); }
.search-bar { display: flex; align-items: center; gap: 12rpx; margin: 12rpx 32rpx 16rpx; padding: 16rpx 24rpx; background-color: #f3f4f6; border-radius: 16rpx; flex-shrink: 0; }
.search-input { flex: 1; height: 48rpx; font-size: 28rpx; color: var(--gcc-text); background: transparent; }
.search-list { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; max-height: calc(70vh - 240px); }
.search-list--short { max-height: calc(60vh - 240px); }
.search-empty { display: flex; align-items: center; justify-content: center; padding: 80rpx 0; }
.search-empty-text { font-size: 28rpx; color: var(--gcc-text-muted); }
.search-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f3f4f6; transition: background-color 0.1s; }
.search-item:last-child { border-bottom: none; }
.search-item--hover { background-color: #f0fdfa; }
.search-item-main { display: flex; align-items: baseline; gap: 12rpx; flex: 1; min-width: 0; }
.search-item-label { font-size: 30rpx; font-weight: 600; color: var(--gcc-text); }
.search-item-sub { font-size: 26rpx; color: var(--gcc-text-secondary); }
.search-item-tag { flex-shrink: 0; font-size: 24rpx; font-weight: 500; color: var(--gcc-primary-dark); padding: 6rpx 16rpx; border-radius: 8rpx; background-color: #f0fdfa; border: 1rpx solid #ccfbf1; margin-left: 16rpx; }
.search-popup-footer { flex-shrink: 0; padding: 16rpx 32rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04); display: flex; gap: 16rpx; }
.search-popup-footer van-button { flex: 1; }

/* 多选项样式 */
.search-item--check { cursor: pointer; }
.search-item--selected { background-color: #eef2ff; }
.check-circle { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #d1d5db; flex-shrink: 0; }
