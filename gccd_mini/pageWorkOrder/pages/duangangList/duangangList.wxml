<!-- [AI-2026-08] 圆钢展示与筛选顺序：名称、厂商、材质、型号。 -->
<view class="page">
  <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
    <view class="navbar-left" bindtap="goBack">‹</view>
    <view class="navbar-title">断钢报工</view>
    <view class="navbar-right"></view>
  </view>

  <view class="body" style="padding-top: {{statusBarHeight + 44}}px">
    <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#0d9488">
      <van-tab title="进行中" name="0"></van-tab>
      <van-tab title="已完成" name="1"></van-tab>
    </van-tabs>

    <view class="filter-bar">
      <input
        class="filter-input"
        placeholder="圆钢名称"
        value="{{y_material_name}}"
        data-field="y_material_name"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onKeywordConfirm"
      />
      <input class="filter-input" placeholder="圆钢厂商" value="{{y_material_manufacturer}}" data-field="y_material_manufacturer" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onKeywordConfirm" />
      <input class="filter-input" placeholder="圆钢材质" value="{{y_material_spec}}" data-field="y_material_spec" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onKeywordConfirm" />
      <input class="filter-input" placeholder="圆钢型号" value="{{y_material_model}}" data-field="y_material_model" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onKeywordConfirm" />
      <view wx:if="{{y_material_name || y_material_manufacturer || y_material_spec || y_material_model}}" class="filter-clear" bindtap="onFilterReset">重置筛选</view>
    </view>

    <scroll-view scroll-y class="list-scroll" bindscrolltolower="loadMore">
      <view wx:for="{{list}}" wx:key="id" class="card" bindtap="goReport" data-id="{{item.id}}">
        <view class="card-title">{{item.display_title}}</view>
        <view class="spec-grid">
          <view class="spec-row">
            <text class="spec-label">圆钢名称</text>
            <text class="spec-value">{{item.y_material_name || '—'}}</text>
          </view>
          <view class="spec-row">
            <text class="spec-label">圆钢厂商</text>
            <text class="spec-value">{{item.y_material_manufacturer || '—'}}</text>
          </view>
          <view class="spec-row">
            <text class="spec-label">圆钢材质</text>
            <text class="spec-value">{{item.y_material_spec || item.display_y_material_spec || '—'}}</text>
          </view>
          <view class="spec-row">
            <text class="spec-label">圆钢型号</text>
            <text class="spec-value">{{item.y_material_model || '—'}}</text>
          </view>
          <view class="spec-row">
            <text class="spec-label">成品规格</text>
            <text class="spec-value">{{item.c_material_spec || '—'}}</text>
          </view>
        </view>
        <view class="card-row">计划 {{item.capacity_total_display || item.capacity_total}} 吨 · 已报 {{item.reported_total_display || item.reported_total}} 吨</view>
        <view class="card-row highlight">剩余 {{item.remain_total_display || item.remain_total}} 吨</view>
      </view>
      <view wx:if="{{!loading && list.length === 0}}" class="empty">
        {{y_material_name || y_material_manufacturer || y_material_spec || y_material_model ? '未找到匹配的合并任务' : '暂无'}}{{activeTab === '0' ? '进行中' : '已完成'}}{{y_material_name || y_material_manufacturer || y_material_spec || y_material_model ? '' : '合并任务'}}
      </view>
    </scroll-view>
  </view>
  <van-toast id="van-toast" />
</view>
