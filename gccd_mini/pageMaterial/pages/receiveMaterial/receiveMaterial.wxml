<!-- [AI-2026-08] 圆钢四字段顺序：名称、厂商、材质、型号。 -->
<!-- 自定义导航栏 -->
<view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
    <van-icon name="arrow-left" class="back-icon" bind:click="navigateBack" />
    <view class="navbar-title">物料领用</view>
</view>

<!-- 页面内容 -->
<view class="page-content" style="padding-top: {{statusBarHeight + 44}}px">
    <!-- 物料列表 -->
    <view class="section-title">可选物料</view>
    <view class="filter-grid">
        <van-search value="{{searchParams.material_name}}" placeholder="名称" shape="round" bind:change="onSearchChange" data-field="material_name" />
        <van-search value="{{searchParams.manufacturer}}" placeholder="厂商" shape="round" bind:change="onSearchChange" data-field="manufacturer" />
        <van-search value="{{searchParams.material_spec}}" placeholder="{{warehouseType === '圆钢库' ? '材质' : '规格'}}" shape="round" bind:change="onSearchChange" data-field="material_spec" />
        <van-search value="{{searchParams.material_model}}" placeholder="型号" shape="round" bind:change="onSearchChange" data-field="material_model" />
    </view>

    <view class="table-container">
        <!-- 表头 -->
        <view class="table-header">
            <view class="th name-col">{{warehouseType === '圆钢库' ? '圆钢名称' : (warehouseType === '配件库' ? '配件名称' : '名称')}}</view>
            <view class="th spec-col">厂商</view>
            <view class="th spec-col">{{warehouseType === '圆钢库' ? '材质' : '规格'}}</view>
            <view class="th model-col">型号</view>
            <view class="th stock-col">库存</view>
            <view class="th check-col">选择</view>
        </view>
        <!-- 表格内容 -->
        <van-checkbox-group value="{{selectedMaterials}}" bind:change="onMaterialSelect">
            <view class="table-body">
                <block wx:for="{{materialList}}" wx:key="id">
                    <label class="table-row">
                        <view class="td name-col">{{item.material_name || '-'}}</view>
                        <view class="td spec-col">{{item.manufacturer || '-'}}</view>
                        <view class="td spec-col">{{item.material_spec || '-'}}</view>
                        <view class="td model-col">{{item.material_model || '-'}}</view>
                        <view class="td stock-col">{{item.material_num || 0}}</view>
                        <view class="td check-col">
                            <van-checkbox name="{{item.material_id}}" catchtap="noop" />
                        </view>
                    </label>
                </block>
            </view>
        </van-checkbox-group>
    </view>

    <!-- 分页加载提示 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
        <van-loading size="16px" /> 加载中...
    </view>
    <view wx:if="{{!hasMore && materialList.length > 0}}" class="no-more">
        没有更多数据了
    </view>



    <!-- 提交按钮 -->
    <view class="submit-btn">
        <van-button type="primary" block round bind:click="submitReceiving" loading="{{loading}}" disabled="{{submitting}}" bind:click="showPopup">
            提交领料
        </van-button>
    </view>
</view>

<!-- 已选物料及数量 -->
<!-- 修改后的 popup 部分 -->
<van-popup show="{{ show }}" bind:close="onClose" position="bottom" custom-style="height: 60%; border-radius: 16px 16px 0 0;">
    <view class="popup-header">
        <view class="section-title">领料数量</view>
        <van-icon name="cross" class="close-icon" bind:click="onClose" />
    </view>
    <scroll-view scroll-y class="popup-content">
        <van-cell-group>
            <van-field wx:for="{{selectedMaterialsInfo}}" wx:key="material_id" label="{{item.material_name}} / {{item.manufacturer}} / {{item.material_spec}} / {{item.material_model}}" placeholder="请输入数量" type="number" border="{{false}}" value="{{item.material_num}}" bind:input="onQuantityChange" data-id="{{item.material_id}}" label-width="60%" input-align="right">
                <view slot="right-icon" class="field-right">
                    <van-stepper value="{{item.material_num}}" data-id="{{item.material_id}}" bind:change="onStepperChange" min="0" max="{{item.stock}}" integer />
                    <van-icon name="delete-o" class="delete-icon" bind:click="removeMaterial" data-id="{{item.material_id}}" />
                </view>
            </van-field>
        </van-cell-group>
    </scroll-view>
    <view class="popup-footer">
        <van-button type="primary" block round bind:click="submitReceiving" loading="{{loading}}" disabled="{{submitting}}" custom-style="margin: 10px 15px;">
            确认提交
        </van-button>
    </view>
</van-popup>

<van-dialog
    show="{{ showSubmitSuccessDialog }}"
    title="提交成功"
    message="领料已成功提交。若刚才网络较慢，请勿重复点击提交；可到上一页列表核对是否已有记录。"
    show-cancel-button="{{ false }}"
    confirm-button-text="确定"
    close-on-click-overlay="{{ false }}"
    bind:confirm="onSubmitSuccessConfirm"
    bind:close="onSubmitSuccessDialogClose"
/>