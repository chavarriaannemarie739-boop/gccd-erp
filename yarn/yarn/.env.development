# 开发环境
NODE_ENV = 'development'

# 本地预览：在 yarn 目录执行 npm run dev（会先释放 9526/9527，再同时起 PHP + Vite）。
# 前端：http://localhost:9527/ ；若 hosts 把 gaochi.com 指到本机，也可用 http://gaochi.com:9527/
# 仅起前端、自己另开 PHP 时可用：npm run dev:vite + npm run php:local
# Vite（9527）与 phpStudy 站点（80）不同端口；后端用 phpStudy 时一般不必再执行 php:local。

# 接口留空：浏览器只访问 Vite 端口，/admin 由 Vite 转发到 DEV_PROXY_TARGET
VITE_APP_BASE_URL = ''

# 浏览器里 /admin 会代理到此地址（phpStudy 虚拟主机 gaochi.com、HTTP 默认 80 端口）
# 与「npm run php:local」二选一：用 phpStudy 时写 http://gaochi.com 即可（不必写 :80）
DEV_PROXY_TARGET = http://127.0.0.1:9526

# base
VITE_APP_BASE = '/'
# outDir
VITE_APP_OUT_DIR = 'admin'
