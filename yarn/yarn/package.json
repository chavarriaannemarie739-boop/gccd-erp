{
  "name": "yyladminweb",
  "version": "4.0.0",
  "description": "Minimalist background management system based on ThinkPHP and Vue",
  "keywords": [
    "yylAdmin",
    "yylAdminWeb",
    "php",
    "vue",
    "thinkphp",
    "element-plus"
  ],
  "author": "https://github.com/skyselang/",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "php:local": "cd ../../gccd_server/public && php -d max_execution_time=300 -S 127.0.0.1:9526 router.php",
    "dev:vite": "node scripts/ensure-node-for-vite.mjs && vite serve --mode development",
    "dev": "node scripts/free-dev-ports.mjs && concurrently -k -n php,vite -c cyan,magenta \"npm run php:local\" \"npm run dev:vite\"",
    "dev:all": "npm run dev",
    "build:prod": "vite build --mode production",
    "build:dv": "vite build --mode dv.production && node scripts/postbuild-dv.mjs",
    "build:stage": "vite build --mode staging",
    "dev:dv": "node scripts/ensure-node-for-vite.mjs && vite serve --mode dv.development",
    "preview:prod": "vite preview --mode production",
    "preview:stage": "vite preview --mode staging",
    "lint": "eslint --ext .js,.cjs,.vue ./src",
    "format": "prettier --write \"**/*.{js,cjs,json,css,less,scss,vue,html,md}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tsparticles/slim": "^3.5.0",
    "@tsparticles/vue3": "^3.0.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vueuse/core": "^10.11.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "5.1.10",
    "@wangeditor/plugin-upload-attachment": "^1.1.0",
    "axios": "^1.7.7",
    "clipboardy": "^4.0.0",
    "crypto-js": "^4.2.0",
    "default-passive-events": "^2.0.0",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.1",
    "html2canvas": "^1.4.1",
    "nprogress": "^0.2.0",
    "number-precision": "^1.6.0",
    "particles.vue3": "^2.9.3",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^6.2.2",
    "pinia": "^2.2.2",
    "qrcode.vue": "^3.6.0",
    "tsparticles": "^2.9.3",
    "vue": "^3.5.3",
    "vue-i18n": "^9.14.0",
    "vue-qr": "^4.0.9",
    "vue-router": "^4.4.3",
    "vue-seamless-scroll": "^1.1.23",
    "vue3-print-nb": "^0.1.4",
    "vue3-seamless-scroll": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.3",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "fast-glob": "^3.3.2",
    "postcss-px-to-viewport": "^1.1.1",
    "prettier": "^2.8.8",
    "sass": "^1.78.0",
    "terser": "^5.48.0",
    "unocss": "^0.58.9",
    "unplugin-auto-import": "^0.15.3",
    "unplugin-icons": "^0.16.6",
    "unplugin-vue-components": "^0.24.1",
    "vite": "^5.4.3",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/skyselang/yylAdminWeb.git"
  },
  "bugs": {
    "url": "https://gitee.com/skyselang/yylAdminWeb/issues"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=8.19.0"
  }
}
